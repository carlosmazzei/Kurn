   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <!-- Moved off the legacy Testables list into Kurn.xctestplan (repo root)
           so KurnTests can be marked non-parallelizable — see that file and
           docs/resilience-megaplan.md's H2 PR 4 handoff for why: Swift Testing
           runs the whole suite in one process by default, and CI was
           repeatedly hitting a known SwiftData concurrency crash
           (radar-tracked, e.g. FB14089213) under that default. The
           ScreenshotUITests skip (needs fastlane's snapshot setup; see that
           file's header comment) now lives in the test plan's
           `skippedTests`. -->
      <TestPlans>
         <TestPlanReference
            reference = "container:Kurn.xctestplan"
            default = "YES">
         </TestPlanReference>
      </TestPlans>
   </TestAction>
